# Copy to .env and keep credentials private. Do not commit .env.
# Release behavior is defined separately in configs/release-enhanced.env.
# Set an OpenAI-compatible provider endpoint reachable from the service.
MEMORY_LLM_BASE_URL=http://127.0.0.1:8080/v1
MEMORY_LLM_API_KEY=
MEMORY_PORT=8088
# For Docker Desktop, Ollama runs on the host; install the pinned embedding first.
DOCKER_EMBEDDING_BASE_URL=http://host.docker.internal:11434
